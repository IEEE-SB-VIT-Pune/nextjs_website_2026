# MongoDB Database Connection URI
MONGODB_URI=mongodb://localhost:27017/clubcms

# JWT Configurations
JWT_SECRET=your-secret-jwt-key-32-chars-long
JWT_EXPIRES_IN=7d

# Database Seed Credentials (Keep these secure and out of git repository!)
# Used by src/scripts/seed.js to create the initial administrative and user accounts.
SEED_ADMIN_EMAIL=admin@clubcms.com
SEED_ADMIN_PASSWORD=change-me-to-a-secure-password
SEED_USER_EMAIL=user@clubcms.com
SEED_USER_PASSWORD=change-me-to-a-secure-password

# Google OAuth Integration Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_SHEET_ID=""
GOOGLE_RESPONSE_SHEET_ID=""

# Gmail SMTP Configurations (Port 465 for SSL/TLS secure connection)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="true"
